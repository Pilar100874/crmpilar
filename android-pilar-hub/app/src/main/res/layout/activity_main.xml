<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_page">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilar Coletor"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtEmpresa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">
        <Button android:id="@+id/btnLigarParar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:background="@drawable/btn_primary" android:text="Parar coletor" android:textAllCaps="false" android:textColor="@android:color/white" />
        <Button android:id="@+id/btnSincronizar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/btn_secondary" android:text="Sincronizar agora" android:textAllCaps="false" android:textColor="@color/text_primary" />
    </LinearLayout>

    <Button
        android:id="@+id/btnFilial"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_secondary"
        android:text="Unidade: todas"
        android:textAllCaps="false"
        android:textColor="@color/text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">
        <Button android:id="@+id/btnPonto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:background="@drawable/btn_secondary" android:text="Ponto ligado" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="13sp" />
        <Button android:id="@+id/btnAutomacao" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginStart="8dp" android:background="@drawable/btn_secondary" android:text="Automação ligada" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="13sp" />
        <Button android:id="@+id/btnLimpar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginStart="8dp" android:background="@drawable/btn_secondary" android:text="Limpar avisos" android:textAllCaps="false" android:textColor="@color/text_muted" android:textSize="13sp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Relógios de ponto" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/listaRelogios" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="16dp" android:orientation="vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dispositivos de automação" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/listaDispositivos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <Button android:id="@+id/btnAtualizarApp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:background="@drawable/btn_secondary" android:text="Atualizar aplicativo" android:textAllCaps="false" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btnSair" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/btn_secondary" android:text="Sair" android:textAllCaps="false" android:textColor="@color/text_muted" />
    </LinearLayout>
</LinearLayout>
