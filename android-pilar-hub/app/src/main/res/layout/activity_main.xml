<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:orientation="vertical" android:background="@color/iso_page">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="22dp" android:paddingEnd="20dp" android:paddingBottom="24dp" android:background="@drawable/iso_header">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/txtTitulo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="PILAR  |  COLETOR" android:textColor="@android:color/white" android:textSize="19sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/btnSair" android:layout_width="44dp" android:layout_height="40dp" android:background="@drawable/iso_button_outline" android:contentDescription="Sair" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_sair" />
        </LinearLayout>
        <TextView android:id="@+id/txtEmpresa" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#B8C7E0" android:textSize="13sp" />
        <TextView android:id="@+id/txtStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/iso_pill_online" android:paddingStart="12dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="7dp" android:text="Em funcionamento" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtResumo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#B8C7E0" android:textSize="12sp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/iso_card_accent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UNIDADE ATIVA" android:textColor="@color/iso_muted" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtFilialNome" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Nenhuma unidade selecionada" android:textColor="@color/iso_text" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
                <Button android:id="@+id/btnFilial" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="10dp" android:background="@drawable/iso_button_outline" android:text="Selecionar unidade" android:textAllCaps="false" android:textColor="@color/iso_brand" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/txtFilialErro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="8dp" android:textColor="@color/iso_danger" android:textSize="12sp" android:visibility="gone" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/iso_card" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MARCAÇÕES ENVIADAS" android:textColor="@color/iso_muted" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtMarcacoes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/iso_success" android:textSize="26sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/iso_card" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMANDOS EXECUTADOS" android:textColor="@color/iso_muted" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txtComandos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/iso_info" android:textSize="26sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/iso_card" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏱  Coletor de Ponto" android:textColor="@color/iso_text" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtPontoStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/iso_text_secondary" android:textSize="12sp" />
                <Button android:id="@+id/btnPonto" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/iso_button_outline" android:text="Ponto ligado" android:textAllCaps="false" android:textColor="@color/iso_brand" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/iso_card" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡  Coletor de Automação" android:textColor="@color/iso_text" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtAutomacaoStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/iso_text_secondary" android:textSize="12sp" />
                <Button android:id="@+id/btnAutomacao" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/iso_button_outline" android:text="Automação ligada" android:textAllCaps="false" android:textColor="@color/iso_brand" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Equipamentos de ponto" android:textColor="@color/iso_text" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/listaRelogios" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Dispositivos de automação" android:textColor="@color/iso_text" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/listaDispositivos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <Button android:id="@+id/btnLigarParar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:background="@drawable/iso_button_primary" android:text="Parar coletor" android:textAllCaps="false" android:textColor="@android:color/white" />
                <Button android:id="@+id/btnSincronizar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/iso_button_outline" android:text="Verificar agora" android:textAllCaps="false" android:textColor="@color/iso_brand" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:orientation="horizontal">
<ImageButton android:id="@+id/btnAtualizarApp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:background="@drawable/iso_button_outline" android:contentDescription="Atualizar aplicativo" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_atualizar" />
                <ImageButton android:id="@+id/btnLimpar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp" android:layout_marginStart="8dp" android:background="@drawable/iso_button_outline" android:contentDescription="Limpar avisos" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_limpar" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
