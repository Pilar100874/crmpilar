<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_page" android:fillViewport="true"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical"
        android:padding="30dp">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:gravity="center_horizontal"
            android:orientation="vertical" android:padding="26dp">
            <ImageView android:layout_width="132dp" android:layout_height="48dp"
                android:contentDescription="Pilar" android:scaleType="centerInside"
                android:src="@drawable/logo_pilar" />
            <ImageView android:layout_width="76dp" android:layout_height="76dp"
                android:layout_marginTop="14dp" android:contentDescription="Pilar Controle"
                android:src="@mipmap/ic_launcher" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center"
                android:text="Entrar no Pilar Controle" android:textColor="@color/text_primary"
                android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/txt_empresa" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:gravity="center" android:textColor="@color/text_muted"
                android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="E-mail"
                android:textColor="@color/text_primary" android:textSize="15sp"
                android:textStyle="bold" />
            <EditText android:id="@+id/campo_email" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="7dp"
                android:autofillHints="emailAddress" android:background="@drawable/bg_input"
                android:hint="seu@email.com" android:inputType="textEmailAddress"
                android:maxLines="1" android:padding="16dp" android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="Senha"
                android:textColor="@color/text_primary" android:textSize="15sp"
                android:textStyle="bold" />
            <EditText android:id="@+id/campo_senha" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="7dp"
                android:autofillHints="password" android:background="@drawable/bg_input"
                android:hint="Sua senha" android:imeOptions="actionDone"
                android:inputType="textPassword" android:maxLines="1" android:padding="16dp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" />
            <Button android:id="@+id/btn_entrar" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="20dp"
                android:background="@drawable/btn_primary" android:text="Entrar"
                android:textAllCaps="false" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/txt_status_login" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:gravity="center" android:textColor="@color/text_muted"
                android:textSize="13sp" />
            <Button android:id="@+id/btn_trocar_empresa" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:background="@android:color/transparent" android:text="Trocar empresa"
                android:textAllCaps="false" android:textColor="@color/text_muted" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
