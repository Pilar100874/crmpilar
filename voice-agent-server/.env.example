# Backend do CRM
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
# Mesma chave do servidor de agentes (AIP_RUNNER_KEY no CRM)
RUNNER_KEY=...
# Empresa (estabelecimento) atendida por este servidor
ESTABELECIMENTO_ID=uuid-da-empresa

# Central UCM
UCM_HOST=192.168.0.10
UCM_PORTA=5060
SIP_SENHA=senha-do-ramal-da-ia
# IP desta máquina na rede da central (para o áudio RTP)
IP_LOCAL=192.168.0.50
# Código da central para escutar um ramal em silêncio (modo "Ajudar o atendente")
CODIGO_ESCUTA=*45
