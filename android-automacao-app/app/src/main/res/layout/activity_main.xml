<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_page">

    <WebView
        android:id="@+id/webPainel"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/painelAviso"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_page"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Carregando painel…"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
        <Button
            android:id="@+id/btnTentarNovamente"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_primary"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Tentar de novo"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Área invisível: segurar no canto superior direito abre as opções do aplicativo. -->
    <View
        android:id="@+id/areaOculta"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:contentDescription="@null" />
</FrameLayout>
