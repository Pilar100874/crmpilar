<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/activation_bg" android:fillViewport="true" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:padding="30dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/activation_card" android:gravity="center_horizontal"
            android:orientation="vertical" android:padding="26dp">
            <ImageView android:layout_width="132dp" android:layout_height="48dp"
                android:contentDescription="Pilar" android:scaleType="centerInside" android:src="@drawable/logo_pilar" />
            <ImageView android:layout_width="46dp" android:layout_height="46dp" android:layout_marginTop="16dp"
                android:contentDescription="Chave" android:src="@drawable/ic_key" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center" android:text="Ativar Pilar SMS"
                android:textColor="@color/activation_text" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center"
                android:text="Informe a chave deste aparelho para vinculá-lo à empresa."
                android:textColor="@color/activation_muted" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:text="Chave da empresa"
                android:textColor="@color/activation_text" android:textSize="16sp" android:textStyle="bold" />
            <EditText android:id="@+id/campo_chave" android:layout_width="match_parent"
                android:layout_height="58dp" android:layout_marginTop="8dp" android:background="@drawable/activation_input"
                android:gravity="center" android:hint="XXXX-XXXX" android:inputType="textCapCharacters"
                android:letterSpacing="0.15" android:maxLines="1" android:padding="14dp"
                android:textColor="@color/activation_text" android:textColorHint="@color/activation_muted" android:textSize="19sp" />
            <Button android:id="@+id/btn_ativar" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="18dp" android:background="@drawable/activation_button"
                android:text="Ativar aparelho" android:textAllCaps="false" android:textColor="@color/white"
                android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/txt_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center"
                android:textColor="@color/activation_muted" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>