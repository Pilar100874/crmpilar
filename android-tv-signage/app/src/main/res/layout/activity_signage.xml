<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/txtStandby"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:visibility="gone" />

    <!-- Tela de atualização do APK (OTA) -->
    <LinearLayout
        android:id="@+id/updateOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/updTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atualizando aplicativo"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/updVersao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9CC7FF"
            android:textSize="20sp" />

        <ProgressBar
            android:id="@+id/updProgresso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="620dp"
            android:layout_height="18dp"
            android:layout_marginTop="28dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/updPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="0%"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/updRestante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B8C4D0"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/updStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Verificando versão mais nova..."
            android:textColor="#E6E6E6"
            android:textSize="20sp" />
    </LinearLayout>


    <!-- Zona invisível no canto superior esquerdo: pressione longo (~3s) para sair -->
    <View
        android:id="@+id/exitHotspot"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:contentDescription="exit"
        android:focusable="false"
        android:clickable="true"
        android:longClickable="true" />
</FrameLayout>
