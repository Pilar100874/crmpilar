<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pilar logo (black wordmark on white) centered in the adaptive safe zone -->
    <item
        android:gravity="center"
        android:width="70dp"
        android:height="28dp">
        <bitmap
            android:src="@drawable/logo_pilar"
            android:gravity="center"
            android:tint="#000000" />
    </item>
    <!-- Blue TV badge in bottom-right corner -->
    <item android:drawable="@drawable/ic_launcher_tv_badge" />
</layer-list>
